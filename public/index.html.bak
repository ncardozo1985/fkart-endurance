{n:'145',d:950,dif:'DIFICIL',st:'suspenso',id:'1f7_ecT9GE4gj6L7ZG8BH3A0QYS-0zX45'}
],
demo_data:[
{pos:1,kart:'013',t:'PICOLE',cat:'SUPER PRO',laps:52,last:'00:51.800',best:'00:51.491',diff:'+0.000',gap:'+0.000'},
{pos:2,kart:'027',t:'TROVAO',cat:'SUPER PRO',laps:52,last:'00:51.900',best:'00:51.650',diff:'+0.159',gap:'+0.159'},
{pos:3,kart:'064',t:'FKART PILOTO A',cat:'SUPER PRO',laps:51,last:'00:52.300',best:'00:52.200',diff:'+0.709',gap:'+1 volta'},
{pos:4,kart:'088',t:'RELAMPAGO',cat:'ELITE',laps:51,last:'00:52.500',best:'00:52.380',diff:'+0.889',gap:'+1 volta'},
{pos:5,kart:'045',t:'TUBARAO',cat:'ELITE',laps:50,last:'00:52.600',best:'00:52.500',diff:'+1.009',gap:'+2 voltas'},
{pos:6,kart:'037',t:'FKART PILOTO B',cat:'ELITE',laps:50,last:'00:52.700',best:'00:52.650',diff:'+1.159',gap:'+2 voltas'},
{pos:7,kart:'071',t:'AGUIA',cat:'AMADOR',laps:49,last:'00:53.100',best:'00:52.900',diff:'+1.409',gap:'+3 voltas'},
{pos:8,kart:'002',t:'LEAO',cat:'AMADOR',laps:49,last:'00:53.200',best:'00:53.000',diff:'+1.509',gap:'+3 voltas'},
{pos:9,kart:'033',t:'TOURO',cat:'AMADOR',laps:48,last:'00:53.500',best:'00:53.300',diff:'+1.809',gap:'+4 voltas'},
{pos:10,kart:'055',t:'COBRA',cat:'AMADOR',laps:48,last:'00:53.800',best:'00:53.600',diff:'+2.109',gap:'+4 voltas'},
{pos:11,kart:'019',t:'FALCAO',cat:'AMADOR',laps:47,last:'00:54.000',best:'00:53.800',diff:'+2.309',gap:'+5 voltas'},
{pos:12,kart:'077',t:'LOBO',cat:'AMADOR',laps:47,last:'00:54.200',best:'00:54.000',diff:'+2.509',gap:'+5 voltas'},
{pos:13,kart:'099',t:'JOSE NETO',cat:'AMADOR',laps:47,last:'00:54.500',best:'00:54.200',diff:'+2.709',gap:'+5 voltas'}
],
isMy:function(k){return FK.cfg.myKarts.indexOf(String(k))>=0;},
fmtTime:function(sec){
sec=Math.max(0,Math.floor(sec));
var h=Math.floor(sec/3600);
var m=Math.floor((sec%3600)/60);
var s=sec%60;
if(h>0) return (h<10?'0'+h:h)+':'+(m<10?'0'+m:m)+':'+(s<10?'0'+s:s);
return (m<10?'0'+m:m)+':'+(s<10?'0'+s:s);
},
tab:function(name){
document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('on');});
document.querySelectorAll('.pane').forEach(function(p){p.classList.remove('on');});
var t=document.querySelector('.tab[data-tab="'+name+'"]');
var p=document.getElementById('pane-'+name);
if(t)t.classList.add('on');
if(p)p.classList.add('on');
if(name==='mapa')FK.drawMap101();
if(name==='tracados')FK.rTracados('all');
if(name==='pilotos')FK.rPilotos();
if(name==='comp')FK.rComp();
if(name==='config')FK.renderConfig();
},
loadConfig:function(){
try{
var s=localStorage.getItem('fkart_cfg');
if(s){var c=JSON.parse(s);FK.cfg=Object.assign(FK.cfg,c);}
}catch(e){}
},
saveConfig:function(){
FK.cfg.raceName=document.getElementById('cfg-race-name').value||'Corrida';
FK.cfg.raceId=parseInt(document.getElementById('cfg-race-id').value)||26021;
FK.cfg.raceTotal=parseInt(document.getElementById('cfg-duration').value)||10800;
FK.cfg.apiToken=document.getElementById('cfg-api-token').value||'';
try{localStorage.setItem('fkart_cfg',JSON.stringify(FK.cfg));}catch(e){}
FK.updateTopbar();
FK.rPlacar();
FK.rComp();
FK.rPilotos();
var el=document.getElementById('cfg-race-name');
if(el)el.style.borderColor='#66bb6a';
setTimeout(function(){if(el)el.style.borderColor='';},1500);
alert('Configuracao salva! Karts: '+FK.cfg.myKarts.join(', ')||'nenhum');
},
renderConfig:function(){
var el=document.getElementById('cfg-race-name');if(el)el.value=FK.cfg.raceName;
var er=document.getElementById('cfg-race-id');if(er)er.value=FK.cfg.raceId;
var ed=document.getElementById('cfg-duration');if(ed)ed.value=FK.cfg.raceTotal;
FK.renderKartTags();
},
renderKartTags:function(){
var el=document.getElementById('kart-tags');
if(!el)return;
var html='';
FK.cfg.myKarts.forEach(function(k){
html+='<span class="kart-tag">'+k+'<button onclick="FK.removeKart(\''+k+'\')" title="Remover">&times;</button></span>';
});
if(!html)html='<span style="color:var(--mut);font-size:12px">Nenhum kart adicionado ainda</span>';
el.innerHTML=html;
},
addKart:function(){
var inp=document.getElementById('kart-input');
if(!inp)return;
var k=inp.value.trim().toUpperCase();
if(!k){return;}
if(FK.cfg.myKarts.indexOf(k)>=0){inp.value='';return;}
FK.cfg.myKarts.push(k);
inp.value='';
inp.focus();
FK.renderKartTags();
},
removeKart:function(k){
FK.cfg.myKarts=FK.cfg.myKarts.filter(function(x){return x!==k;});
FK.renderKartTags();
},
resetDemo:function(){
FK.cfg.myKarts=['064','037'];
FK.cfg.raceName='KGV Demo 3h';
FK.cfg.raceTotal=10800;
FK.state.elapsed=2730;
FK.cfg.source='demo';
FK.updateSrcBadge();
FK.renderConfig();
FK.rPlacar();
},
updateTopbar:function(){
var rn=document.getElementById('race-name');
if(rn)rn.textContent=FK.cfg.raceName;
},
updateSrcBadge:function(){
var dot=document.getElementById('src-dot');
var lbl=document.getElementById('src-label');
if(!dot||!lbl)return;
if(FK.cfg.source==='live'){
dot.className='status-dot status-live';lbl.textContent='AO VIVO';
}else{
dot.className='status-dot status-demo';lbl.textContent='DEMO';
}
},
startClock:function(){
if(FK.state.clockInterval)clearInterval(FK.state.clockInterval);
FK.state.clockInterval=setInterval(function(){
if(FK.cfg.source==='demo')FK.state.elapsed++;
var e=FK.state.elapsed;
var rem=Math.max(0,FK.cfg.raceTotal-e);
var elEl=document.getElementById('elapsed');
var remEl=document.getElementById('remaining');
if(elEl)elEl.textContent=FK.fmtTime(e);
if(remEl)remEl.textContent=rem>0?FK.fmtTime(rem):'ENCERRADA';
},1000);
},
rPlacar:function(){
var data=FK.cfg.source==='live'&&FK.state.liveData?FK.state.liveData:FK.demo_data;
var html='';
data.forEach(function(d){
var my=FK.isMy(d.kart);
var pc='';
if(d.pos===1)pc='p1';else if(d.pos===2)pc='p2';else if(d.pos===3)pc='p3';
var star=my?' &#11088;':'';
html+='<tr class="'+(my?'my-kart':'')+'">'+
'<td><span class="pos-badge '+pc+'">'+d.pos+'</span></td>'+
'<td><span class="kart-num'+(my?' my':'')+'">'+d.kart+'</span></td>'+
'<td style="font-weight:'+(my?700:400)+'">'+d.t+star+'</td>'+
'<td class="gap-badge">'+d.cat+'</td>'+
'<td style="color:var(--acc)">'+d.laps+'</td>'+
'<td style="color:'+(my?'var(--acc)':'var(--txt)')+'">'+d.best+'</td>'+
'<td>'+d.last+'</td>'+
'<td class="gap-badge">'+d.gap+'</td>'+
'<td class="gap-badge">'+d.diff+'</td>'+
'</tr>';
});
var el=document.getElementById('placar-body');
if(el)el.innerHTML=html;
var l=data[0];
if(l){var li=document.getElementById('leader-info');if(li)li.textContent=l.kart+' - '+l.t+' ('+l.laps+'v)';}
var fl=document.getElementById('flag-status');
if(fl)fl.textContent=FK.cfg.source==='live'&&FK.state.flagStatus?FK.state.flagStatus:'Verde';
},
rComp:function(){
var data=(FK.cfg.source==='live'&&FK.state.liveData?FK.state.liveData:FK.demo_data).slice(0,10);
if(!data.length)return;
var parseT=function(t){var p=t.replace('00:','').split(':');return p.length===2?parseFloat(p[0])*60+parseFloat(p[1]):parseFloat(p[0]);};
var best=parseT(data[0].best);
var html='';
data.forEach(function(d){
var my=FK.isMy(d.kart);
var t=parseT(d.best);
var pct=Math.min(100,Math.round((best/t)*100));
var color=my?'#F7C600':'#4fc3f7';
html+='<div style="margin-bottom:10px">'+
'<div style="display:flex;justify-content:space-between;margin-bottom:3px">'+
'<span style="font-weight:'+(my?700:400)+';color:'+(my?'var(--acc)':'var(--txt)')+'">'+
'#'+d.pos+' '+d.kart+' - '+d.t+(my?' &#11088;':'')+'</span>'+
'<span class="gap-badge">'+d.best+'</span></div>'+
'<div class="comp-bar-wrap"><div class="comp-bar" style="width:'+pct+'%;background:'+color+'">'+pct+'%</div></div>'+
'</div>';
});
var el=document.getElementById('comp-body');if(el)el.innerHTML=html;
},
startLive:function(){
if(!FK.cfg.apiToken){
alert('Configure o API Token primeiro na aba Config!');FK.tab('config');return;
}
FK.cfg.source='live';FK.state.elapsed=0;
FK.updateSrcBadge();FK.fetchLive();
if(FK.state.liveInterval)clearInterval(FK.state.liveInterval);
FK.state.liveInterval=setInterval(FK.fetchLive,15000);
var st=document.getElementById('config-status');
if(st)st.style.display='block';
var sb=document.getElementById('config-status-body');
if(sb)sb.innerHTML='<span style="color:#66bb6a">&#10003; Conectado - atualizando a cada 15s</span>';
},
fetchLive:function(){
var url='https://api.race-monitor.com/v2/Live/GetSession';
var body='apiToken='+encodeURIComponent(FK.cfg.apiToken)+'&raceID='+FK.cfg.raceId;
var xhr=new XMLHttpRequest();
xhr.open('POST',url);
xhr.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
xhr.onload=function(){
try{
var r=JSON.parse(xhr.responseText);
if(r.Successful&&r.Session){
FK.parseSession(r.Session);
FK.rPlacar();FK.rComp();
}else{
console.warn('FKART Live: '+r.Message);
}
}catch(e){console.error('FKART parse error:',e);}
};
xhr.onerror=function(){console.warn('FKART: falha na requisicao ao vivo');};
xhr.send(body);
},
parseSession:function(s){
FK.state.flagStatus=s.FlagStatus||'Verde';
var comps=[];
var map=s.Competitors||{};
Object.keys(map).forEach(function(k){
var c=map[k];
comps.push({
pos:parseInt(c.Position)||999,
kart:c.Number||k,
t:(c.FirstName||'')+' '+(c.LastName||''),
cat:(s.Classes&&s.Classes[c.ClassID])?s.Classes[c.ClassID].Description:'',
laps:parseInt(c.Laps)||0,
best:c.BestLapTime||'--:--.---',
last:c.LastLapTime||'--:--.---',
gap:'',diff:''
});
});
comps.sort(function(a,b){return a.pos-b.pos;});
if(s.SessionTime){
var parts=s.SessionTime.split(':');
if(parts.length>=2){
var h=parseInt(parts[0])||0;var m=parseInt(parts[1])||0;var sec=parts[2]?parseFloat(parts[2]):0;
FK.state.elapsed=h*3600+m*60+Math.floor(sec);
}
}
FK.state.liveData=comps;
},
rTracados:function(filter){
if(!filter)filter='all';
var g=document.getElementById('tr-grid');if(!g)return;
var html='';
FK.tr.forEach(function(t){
var show=filter==='all'||t.st===filter||t.dif===filter;
if(!show)return;
var dc='dif-'+t.dif.toLowerCase();
var th='https://drive.google.com/thumbnail?id='+t.id+'&sz=w400';
var susp=t.st==='suspenso'?' - SUSPENSO':'';
html+='<div class="tr-card" onclick="FK.openTr(this.dataset.num)" data-num="'+t.n+'">'+
'<img class="tr-thumb" src="'+th+'" alt="'+t.n+'" loading="lazy">'+
'<div class="tr-info"><div class="tr-num">'+t.n+'</div>'+
'<div class="tr-dist">'+t.d+'m</div>'+
'<span class="tr-dif '+dc+'">'+t.dif+susp+'</span></div></div>';
});
if(!html)html='<p style="color:var(--mut);padding:20px">Nenhum tracado</p>';
g.innerHTML=html;
},
filterTr:function(btn,f){
document.querySelectorAll('.tr-filters button').forEach(function(b){b.classList.remove('on');});
btn.classList.add('on');FK.rTracados(f);
},
openTr:function(num){
var t=FK.tr.find(function(x){return x.n===num;});if(!t)return;
document.getElementById('tr-modal-img').src='https://drive.google.com/thumbnail?id='+t.id+'&sz=w800';
document.getElementById('tr-modal-num').textContent='Tracado '+t.n;
var dc='dif-'+t.dif.toLowerCase();
document.getElementById('tr-modal-info').innerHTML=
'Distancia: <strong style="color:var(--acc)">'+t.d+'m</strong><br>'+
'Dificuldade: <span class="tr-dif '+dc+'">'+t.dif+'</span><br>'+
'Status: '+(t.st==='ativo'?'<span style="color:#66bb6a">&#10003; Ativo</span>':'<span style="color:#ef5350">&#9888; Suspenso</span>')+'<br>'+
'Tempo estimado: ~'+Math.round(t.d/23.6)+'s por volta';
document.getElementById('tr-overlay').classList.add('show');
},
closeTr:function(){document.getElementById('tr-overlay').classList.remove('show');},
rPilotos:function(){
var html='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">';
if(FK.cfg.myKarts.length===0){
html+='<p style="color:var(--mut);padding:8px">Nenhum kart configurado. Va em Config para adicionar.</p>';
}
FK.cfg.myKarts.forEach(function(k){
var data=FK.cfg.source==='live'&&FK.state.liveData?FK.state.liveData:FK.demo_data;
var d=data.find(function(x){return String(x.kart)===k;});
var pos=d?'P'+d.pos:'--';var best=d?d.best:'--:--.---';var laps=d?d.laps:'--';
html+='<div class="card" style="border-color:var(--acc)">'+
'<div style="display:flex;align-items:center;gap:12px">'+
'<span class="kart-num my">'+k+'</span>'+
'<div><div style="font-weight:700;color:var(--acc)">Kart '+k+' &#11088;</div>'+
'<div style="color:var(--mut);font-size:11px">'+pos+' &middot; '+laps+' voltas &middot; Melhor: '+best+'</div></div></div></div>';
});
html+='</div>';
var el=document.getElementById('pilotos-body');if(el)el.innerHTML=html;
},
loadWx:function(){
var url='https://api.open-meteo.com/v1/forecast?latitude=-23.6014&longitude=-46.8575&current=temperature_2m,weathercode,windspeed_10m,winddirection_10m,windgusts_10m,precipitation_probability&timezone=America/Sao_Paulo';
var xhr=new XMLHttpRequest();xhr.open('GET',url);
xhr.onload=function(){try{
var d=JSON.parse(xhr.responseText).current;
var wc=d.weathercode;
var icon=wc===0?'Limpo':wc<=2?'Nublado parcial':wc<=3?'Nublado':wc<=67?'Chuva':'Neve';
var dirs=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSO','SO','OSO','O','ONO','NO','NNO'];
var di=Math.round(d.winddirection_10m/22.5)%16;
var rain=d.precipitation_probability>=30;
var wx=document.getElementById('wxbar');
if(wx)wx.innerHTML='KGV | '+icon+' | '+d.windspeed_10m+'km/h '+dirs[di]+' | <span style="color:var(--acc)">'+d.temperature_2m+'C</span> | <strong style="color:'+(rain?'#4fc3f7':'#66bb6a')+'">'+(rain?'Chuva possivel':'Sem chuva')+'</strong>';
}catch(e){var wx2=document.getElementById('wxbar');if(wx2)wx2.textContent='KGV - Granja Viana';}};
xhr.onerror=function(){var wx3=document.getElementById('wxbar');if(wx3)wx3.textContent='KGV - Granja Viana';};
xhr.send();setInterval(function(){FK.loadWx();},600000);
},
_pts:function(){var W=800,H=500;return [[0.12,0.22],[0.18,0.18],[0.28,0.15],[0.40,0.14],[0.52,0.14],[0.62,0.15],[0.72,0.18],[0.80,0.24],[0.84,0.32],[0.82,0.40],[0.76,0.46],[0.68,0.50],[0.60,0.52],[0.54,0.56],[0.52,0.64],[0.54,0.72],[0.60,0.78],[0.68,0.82],[0.76,0.82],[0.82,0.78],[0.86,0.70],[0.84,0.62],[0.78,0.58],[0.70,0.56],[0.62,0.60],[0.56,0.68],[0.50,0.76],[0.42,0.80],[0.32,0.80],[0.22,0.76],[0.14,0.68],[0.10,0.58],[0.10,0.46],[0.12,0.34],[0.12,0.22]].map(function(p){return[p[0]*W,p[1]*H];});},
drawMap101Static:function(){
var cv=document.getElementById('mapa-canvas');if(!cv)return;
var ctx=cv.getContext('2d');var W=FK.state.mapW,H=FK.state.mapH;
cv.width=W*2;cv.height=H*2;cv.style.width=W+'px';cv.style.height=H+'px';ctx.scale(2,2);
ctx.fillStyle='#0a0c10';ctx.fillRect(0,0,W,H);
ctx.fillStyle='rgba(0,40,0,0.3)';ctx.beginPath();ctx.ellipse(W*0.5,H*0.5,W*0.44,H*0.38,0,0,Math.PI*2);ctx.fill();
var pts=FK._pts();
var sectors=[{from:0,to:5,color:'#F7C600'},{from:5,to:17,color:'#4fc3f7'},{from:17,to:pts.length-1,color:'#81c784'}];
sectors.forEach(function(s){ctx.beginPath();ctx.moveTo(pts[s.from][0],pts[s.from][1]);for(var i=s.from+1;i<=s.to&&i<pts.length;i++)ctx.lineTo(pts[i][0],pts[i][1]);ctx.strokeStyle=s.color;ctx.lineWidth=7;ctx.lineCap='round';ctx.lineJoin='round';ctx.shadowColor=s.color;ctx.shadowBlur=8;ctx.stroke();ctx.shadowBlur=0;});
ctx.beginPath();ctx.moveTo(pts[0][0],pts[0][1]);ctx.lineTo(pts[1][0],pts[1][1]);ctx.strokeStyle='#ef5350';ctx.lineWidth=4;ctx.shadowColor='#ef5350';ctx.shadowBlur=10;ctx.stroke();ctx.shadowBlur=0;
[0,4,8,11,15,20,25,30].forEach(function(ci,i){if(ci>=pts.length)return;ctx.beginPath();ctx.arc(pts[ci][0],pts[ci][1],7,0,Math.PI*2);ctx.fillStyle='rgba(255,255,255,0.12)';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke();ctx.font='bold 9px sans-serif';ctx.fillStyle='#fff';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('C'+(i+1),pts[ci][0],pts[ci][1]);});
ctx.beginPath();ctx.arc(W*0.47,H*0.47,38,0,Math.PI*2);ctx.fillStyle='rgba(13,15,20,0.85)';ctx.fill();ctx.strokeStyle='#2e3348';ctx.lineWidth=1.5;ctx.stroke();ctx.font='bold 18px sans-serif';ctx.fillStyle='#F7C600';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('101',W*0.47,H*0.44);ctx.font='10px sans-serif';ctx.fillStyle='#7a8099';ctx.fillText('1015m',W*0.47,H*0.51);
[{c:'#F7C600',l:'S1'},{c:'#4fc3f7',l:'S2'},{c:'#81c784',l:'S3'},{c:'#ef5350',l:'S/F'}].forEach(function(item,i){var lx=14,ly=H-62+(i*15);ctx.fillStyle=item.c;ctx.fillRect(lx,ly,15,8);ctx.font='10px sans-serif';ctx.fillStyle='#aaa';ctx.textAlign='left';ctx.textBaseline='middle';ctx.fillText(item.l,lx+19,ly+4);});
},
drawMap101:function(){FK.drawMap101Static();if(FK.state.mapAnim)cancelAnimationFrame(FK.state.mapAnim);FK.state.kartT=0;FK.animateKart();},
animateKart:function(){
var pts=FK._pts();if(!pts||pts.length<2)return;
FK.state.kartT+=0.008;if(FK.state.kartT>=pts.length-1)FK.state.kartT=0;
var seg=Math.floor(FK.state.kartT);var frac=FK.state.kartT-seg;if(seg>=pts.length-1)seg=pts.length-2;
var x=pts[seg][0]+(pts[seg+1][0]-pts[seg][0])*frac;
var y=pts[seg][1]+(pts[seg+1][1]-pts[seg][1])*frac;
FK.drawMap101Static();
var cv=document.getElementById('mapa-canvas');if(!cv)return;
var ctx=cv.getContext('2d');ctx.save();ctx.scale(2,2);
var label=FK.cfg.myKarts[0]||'?';
ctx.beginPath();ctx.ellipse(x,y,14,10,0,0,Math.PI*2);ctx.fillStyle='#F7C600';ctx.shadowColor='#F7C600';ctx.shadowBlur=14;ctx.fill();ctx.shadowBlur=0;
ctx.font='bold 8px sans-serif';ctx.fillStyle='#000';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(label,x,y);ctx.restore();
FK.state.mapAnim=requestAnimationFrame(FK.animateKart);
},
render:function(){
FK.loadConfig();FK.cfg.myKarts=FK.cfg.myKarts||[];
if(FK.cfg.myKarts.length===0)FK.cfg.myKarts=['064','037'];
FK.state.elapsed=FK.cfg.raceTotal>10800?0:2730;
FK.updateTopbar();FK.updateSrcBadge();FK.rPlacar();FK.rComp();
FK.rTracados('all');FK.rPilotos();FK.loadWx();FK.startClock();
}
};
document.querySelectorAll('.tab').forEach(function(t){
t.addEventListener('click',function(){FK.tab(t.getAttribute('data-tab'));});
});
document.getElementById('kart-input').addEventListener('keydown',function(e){if(e.key==='Enter')FK.addKart();});
document.addEventListener('DOMContentLoaded',function(){FK.render();});
if(document.readyState!=='loading')FK.render();
</script>
</body>
</html>
