<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FKART Endurance Monitor v3.0</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--acc:#F7C600;--acc2:#CC2200;--bg:#0c0d0f;--card:#13151a;--txt:#e8eaf0;--mut:#7a8099;--border:#1e2130;--green:#66bb6a;--blue:#4fc3f7;--red:#ef5350}
body{background:var(--bg);color:var(--txt);font-family:'Segoe UI',Arial,sans-serif;font-size:13px;min-height:100vh;display:flex;flex-direction:column}
.topbar{background:linear-gradient(135deg,#0a0b0e,#111318);border-bottom:2px solid var(--acc2);padding:8px 16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.logo-text{font-style:italic;font-weight:900;font-size:24px;letter-spacing:1px;line-height:1;cursor:pointer}
.logo-f{color:#999}.logo-kart{background:linear-gradient(90deg,#CC2200,#FF6600);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.logo-sub{font-size:9px;color:#666;letter-spacing:3px;text-transform:uppercase;margin-top:2px}
.infobar{display:flex;gap:10px;align-items:center;flex:1;flex-wrap:wrap}
.info-badge{background:rgba(247,198,0,0.1);border:1px solid rgba(247,198,0,0.3);border-radius:6px;padding:4px 10px;font-size:11px;white-space:nowrap}
.info-badge span{color:var(--acc);font-weight:700}
.info-badge.red-badge{border-color:rgba(239,83,80,0.5);background:rgba(239,83,80,0.1)}
.info-badge.red-badge span{color:var(--red)}
.info-badge.orange-badge{border-color:rgba(255,167,38,0.4);background:rgba(255,167,38,0.08)}
.info-badge.orange-badge span{color:#ffa726}
.wx-bar{font-size:11px;color:var(--mut);margin-left:auto;white-space:nowrap}
.tabs{display:flex;background:#0a0b0e;border-bottom:1px solid var(--border);overflow-x:auto;flex-shrink:0}
.tabs::-webkit-scrollbar{height:3px}.tabs::-webkit-scrollbar-thumb{background:var(--acc2)}
.tab{padding:10px 14px;cursor:pointer;border-bottom:2px solid transparent;color:var(--mut);font-size:12px;white-space:nowrap;transition:all .2s;user-select:none}
.tab:hover{color:var(--txt);background:rgba(255,255,255,0.04)}
.tab.on{color:var(--acc);border-bottom-color:var(--acc);background:rgba(247,198,0,0.06)}
.content{flex:1;overflow:auto;padding:12px}
.pane{display:none}.pane.on{display:block}
.card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:12px;margin-bottom:8px}
h3{color:var(--acc);font-size:13px;margin-bottom:10px;text-transform:uppercase;letter-spacing:1px}
table{width:100%;border-collapse:collapse}
th{text-align:left;color:var(--mut);font-size:10px;text-transform:uppercase;padding:6px 8px;border-bottom:1px solid var(--border)}
td{padding:7px 8px;border-bottom:1px solid rgba(30,33,48,0.5);font-size:12px;vertical-align:middle}
tr.my-kart td{background:rgba(247,198,0,0.07);color:var(--acc)}
tr.my-kart td:first-child{border-left:3px solid var(--acc)}
tr:hover td{background:rgba(255,255,255,0.02)}
.pos-badge{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:4px;font-weight:700;font-size:11px;background:rgba(255,255,255,0.05)}
.pos-badge.p1{background:linear-gradient(135deg,#FFD700,#FFA000);color:#000}
.pos-badge.p2{background:linear-gradient(135deg,#C0C0C0,#888);color:#000}
.pos-badge.p3{background:linear-gradient(135deg,#CD7F32,#8B4513);color:#fff}
.kart-num{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;font-weight:900;font-size:13px;border:2px solid var(--border);color:var(--txt)}
.kart-num.my{background:var(--acc);color:#000;border-color:var(--acc);box-shadow:0 0 12px rgba(247,198,0,0.4)}
.gap-badge{font-size:10px;color:var(--mut)}
.comp-bar-wrap{background:#1a1d26;border-radius:4px;height:20px;overflow:hidden;margin:2px 0}
.comp-bar{height:100%;display:flex;align-items:center;padding:0 6px;font-size:10px;font-weight:700;transition:width .6s ease}
.tr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:10px}
.tr-card{background:var(--card);border:1px solid var(--border);border-radius:8px;overflow:hidden;cursor:pointer;transition:all .2s}
.tr-card:hover{border-color:var(--acc);transform:translateY(-2px);box-shadow:0 4px 16px rgba(247,198,0,0.15)}
.tr-thumb{width:100%;height:95px;object-fit:cover;background:#1a1d26}
.tr-info{padding:8px}
.tr-num{font-weight:900;font-size:16px;color:var(--acc)}
.tr-dist{color:var(--mut);font-size:11px}
.tr-dif{display:inline-block;font-size:10px;padding:2px 6px;border-radius:3px;margin-top:4px;font-weight:700}
.dif-iniciante,.dif-facil{background:rgba(102,187,106,0.15);color:#66bb6a}
.dif-medio{background:rgba(79,195,247,0.15);color:#4fc3f7}
.dif-dificil{background:rgba(255,167,38,0.15);color:#ffa726}
.dif-expert{background:rgba(239,83,80,0.15);color:#ef5350}
.tr-filters{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
.tr-filters button{padding:5px 12px;border:1px solid var(--border);background:var(--card);color:var(--mut);border-radius:4px;cursor:pointer;font-size:11px;transition:all .15s}
.tr-filters button.on{border-color:var(--acc);color:var(--acc);background:rgba(247,198,0,0.08)}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:200;align-items:center;justify-content:center}
.overlay.show{display:flex}
.modal{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px;max-width:640px;width:92%;max-height:92vh;overflow-y:auto;position:relative}
.modal img{width:100%;border-radius:8px;margin-bottom:12px}
.modal-close{position:absolute;top:12px;right:14px;background:none;border:none;color:var(--mut);font-size:22px;cursor:pointer}
.mapa-stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.stat-box{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:8px 14px;text-align:center;flex:1;min-width:80px}
.stat-box .val{font-size:18px;font-weight:700;color:var(--acc);line-height:1}
.stat-box .lbl{font-size:10px;color:var(--mut);text-transform:uppercase;margin-top:3px}
.cfg-panel{background:rgba(247,198,0,0.04);border:1px solid rgba(247,198,0,0.2);border-radius:10px;padding:16px;margin-bottom:12px}
.cfg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-bottom:14px}
.cfg-field{display:flex;flex-direction:column;gap:4px}
.cfg-field label{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:1px}
.cfg-field input,.cfg-field select{background:#0c0d0f;border:1px solid var(--border);color:var(--txt);padding:7px 10px;border-radius:5px;font-size:13px;outline:none}
.cfg-field input:focus,.cfg-field select:focus{border-color:var(--acc)}
.cfg-field input::placeholder{color:var(--mut)}
.kart-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;min-height:32px}
.kart-tag{background:var(--acc);color:#000;border-radius:4px;padding:3px 8px;font-size:12px;font-weight:700;display:flex;align-items:center;gap:4px}
.kart-tag button{background:none;border:none;color:#333;cursor:pointer;font-size:15px;line-height:1;padding:0}
.kart-input-row{display:flex;gap:6px;margin-top:6px}
.kart-input-row input{flex:1;background:#0c0d0f;border:1px solid var(--border);color:var(--txt);padding:7px 10px;border-radius:5px;font-size:13px;outline:none}
.kart-input-row input:focus{border-color:var(--acc)}
.kart-input-row button{background:var(--acc);color:#000;border:none;border-radius:5px;padding:7px 14px;font-weight:700;cursor:pointer;font-size:12px}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.btn-primary{background:var(--acc);color:#000;border:none;border-radius:6px;padding:9px 20px;font-weight:700;cursor:pointer;font-size:13px}
.btn-secondary{background:transparent;color:var(--mut);border:1px solid var(--border);border-radius:6px;padding:9px 20px;cursor:pointer;font-size:13px}
.btn-secondary:hover{border-color:var(--acc);color:var(--acc)}
.status-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle}
.status-live{background:#ef5350;animation:blink 1.2s infinite}
.status-demo{background:#ffa726}
.status-off{background:var(--mut)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.25}}
.ph{display:flex;align-items:center;justify-content:center;height:150px;color:var(--mut);font-size:14px;border:1px dashed var(--border);border-radius:8px;flex-direction:column;gap:6px}
.ph small{font-size:11px;color:#2a2d38}
canvas{border-radius:8px;max-width:100%;display:block}
footer{text-align:center;padding:8px;color:#2a2d38;font-size:10px;border-top:1px solid #111;letter-spacing:2px}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
</style>
</head>
<body>
<div class="topbar">
<div onclick="FK.tab('config')" title="Configurar corrida">
<div class="logo-text"><span class="logo-f">F</span><span class="logo-kart">KART</span></div>
<div class="logo-sub">Force Kart Racing</div>
</div>
<div class="infobar">
<div class="info-badge red-badge"><span class="status-dot status-live" id="src-dot"></span><span id="src-label">DEMO</span></div>
<div class="info-badge">Corrida: <span id="race-name">KGV Endurance</span></div>
<div class="info-badge">Decorrido: <span id="elapsed">00:00:00</span></div>
<div class="info-badge">Restante: <span id="remaining">--:--:--</span></div>
<div class="info-badge">Flag: <span id="flag-status">-</span></div>
<div class="info-badge">Lider: <span id="leader-info">-</span></div>
<div class="wx-bar" id="wxbar">KGV - Granja Viana</div>
</div>
</div>
<div class="tabs" id="tabs">
<div class="tab on" data-tab="ranking">&#127937; Ranking</div>
<div class="tab" data-tab="comp">&#128200; Comparativo</div>
<div class="tab" data-tab="crono">&#9201; Crono</div>
<div class="tab" data-tab="mapa">&#128506; Mapa</div>
<div class="tab" data-tab="tracados">&#128194; Tracados</div>
<div class="tab" data-tab="pilotos">&#128100; Pilotos</div>
<div class="tab" data-tab="config">&#9881; Config</div>
</div>
<div class="content">
<div class="pane on" id="pane-ranking">
<div class="card"><h3>&#127937; Classificacao Geral</h3>
<table><thead><tr><th>Pos</th><th>Kart</th><th>Piloto</th><th>Cat</th><th>Voltas</th><th>Melhor</th><th>Ultima</th><th>Gap</th><th>Diff</th></tr></thead>
<tbody id="placar-body"></tbody></table></div></div>
<div class="pane" id="pane-comp">
<div class="card"><h3>&#128200; Comparativo de Performance</h3><div id="comp-body"></div></div></div>
<div class="pane" id="pane-crono">
<div class="card"><h3>&#9201; Cronometro - Meus Karts</h3><div id="crono-body"><div class="ph">&#9201;<br><small>Aguardando dados ao vivo...</small></div></div></div></div>
<div class="pane" id="pane-mapa">
<div class="card"><h3>&#128506; Mapa Virtual - Tracado 101</h3>
<canvas id="mapa-canvas" width="800" height="500"></canvas>
<div class="mapa-stats">
<div class="stat-box"><div class="val">1015m</div><div class="lbl">Distancia</div></div>
<div class="stat-box"><div class="val">~43s</div><div class="lbl">Por volta</div></div>
<div class="stat-box"><div class="val">~83</div><div class="lbl">Voltas/h</div></div>
<div class="stat-box"><div class="val">INICIANTE</div><div class="lbl">Dificuldade</div></div>
</div></div></div>
<div class="pane" id="pane-tracados">
<div class="card"><h3>&#128194; Tracados KGV - Granja Viana</h3>
<div class="tr-filters">
<button class="on" onclick="FK.filterTr(this,'all')">Todos (31)</button>
<button onclick="FK.filterTr(this,'INICIANTE')">Iniciante</button>
<button onclick="FK.filterTr(this,'FACIL')">Facil</button>
<button onclick="FK.filterTr(this,'MEDIO')">Medio</button>
<button onclick="FK.filterTr(this,'DIFICIL')">Dificil</button>
<button onclick="FK.filterTr(this,'EXPERT')">Expert</button>
<button onclick="FK.filterTr(this,'suspenso')">Suspenso</button>
</div>
<div class="tr-grid" id="tr-grid"></div></div></div>
<div class="pane" id="pane-pilotos">
<div class="card"><h3>&#128100; Pilotos FKART</h3><div id="pilotos-body"></div></div></div>
<div class="pane" id="pane-config">
<div class="cfg-panel">
<h3>&#9881; Configuracao da Corrida</h3>
<div class="cfg-grid">
<div class="cfg-field">
<label>Nome da Corrida</label>
<input type="text" id="cfg-race-name" placeholder="Ex: KGV 3h Endurance" value="KGV Endurance">
</div>
<div class="cfg-field">
<label>Race Monitor ID</label>
<input type="number" id="cfg-race-id" placeholder="Ex: 26021" value="26021">
</div>
<div class="cfg-field">
<label>Duracao Total da Corrida</label>
<select id="cfg-duration">
<option value="3600">1 hora</option>
<option value="5400">1h 30min</option>
<option value="7200">2 horas</option>
<option value="9000">2h 30min</option>
<option value="10800" selected>3 horas</option>
<option value="14400">4 horas</option>
<option value="18000">5 horas</option>
<option value="21600">6 horas</option>
<option value="28800">8 horas</option>
<option value="36000">10 horas</option>
<option value="43200">12 horas</option>
<option value="57600">16 horas</option>
<option value="72000">20 horas</option>
<option value="86400">24 horas</option>
</select>
</div>
<div class="cfg-field">
<label>API Token Race Monitor</label>
<input type="password" id="cfg-api-token" placeholder="Cole o token aqui (quando tiver)">
</div>
</div>
<div class="cfg-field">
<label>Meus Karts nesta Corrida</label>
<div class="kart-tags" id="kart-tags"></div>
<div class="kart-input-row">
<input type="text" id="kart-input" placeholder="Numero do kart (ex: 064)" maxlength="4" oninput="this.value=this.value.toUpperCase()">
<button onclick="FK.addKart()">+ Adicionar</button>
</div>
<small style="color:var(--mut);font-size:11px;margin-top:6px;display:block">Os karts adicionados serao destacados em dourado no ranking. Limpe e reconfigure a cada corrida.</small>
</div>
<div class="btn-row">
<button class="btn-primary" onclick="FK.saveConfig()">&#10003; Salvar e Aplicar</button>
<button class="btn-secondary" onclick="FK.resetDemo()">&#8635; Carregar Demo</button>
<button class="btn-secondary" id="btn-live" onclick="FK.startLive()" style="border-color:rgba(102,187,106,0.4);color:#66bb6a">&#9654; Iniciar Ao Vivo</button>
</div>
</div>
<div class="card" id="config-status" style="display:none">
<h3>Status da Conexao</h3>
<div id="config-status-body"></div>
</div>
</div>
</div>
<div id="tr-overlay" class="overlay" onclick="if(event.target===this)FK.closeTr()">
<div class="modal">
<button class="modal-close" onclick="FK.closeTr()">&#10005;</button>
<img id="tr-modal-img" src="" alt="">
<h3 id="tr-modal-num" style="margin-bottom:8px"></h3>
<div id="tr-modal-info" style="color:var(--mut);font-size:13px;line-height:1.9"></div>
</div></div>
<footer>FORCE KART RACING &middot; SINCE 2004 &middot; TEAM RACE</footer>
<script>
var FK={
/* === CONFIGURACAO DA CORRIDA === */
cfg:{
raceName:'KGV Endurance',
raceId:26021,
raceTotal:10800,
apiToken:'',
myKarts:[],
source:'demo'
},
